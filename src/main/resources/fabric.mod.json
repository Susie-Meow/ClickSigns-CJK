{
  "schemaVersion": 1,
  "id": "clicksigns",
  "version": "${mod_version}",
  "name": "ClickSigns-CJK",
  "description": "MC双语路牌Mod — 支持中文输入法与中文字形的自定义路牌模组 / Bilingual road sign mod for Minecraft: custom highway & street signs with working IME input and CJK glyphs.",
  "authors": [
    "Clickism"
  ],
  "contributors": [
    "Susie-Meow"
  ],
  "contact": {
    "homepage": "https://github.com/Susie-Meow/ClickSigns-CJK",
    "sources": "https://github.com/Susie-Meow/ClickSigns-CJK",
    "issues": "https://github.com/Susie-Meow/ClickSigns-CJK/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/clicksigns/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "de.clickism.clicksigns.platform.fabric.FabricEntrypoint"
      }
    ],
    "client": [
      {
        "value": "de.clickism.clicksigns.platform.fabric.FabricEntrypoint"
      }
    ],
    "fabric-datagen": [
      {
        "value": "de.clickism.clicksigns.platform.fabric.datagen.FabricDatagenEntrypoint"
      }
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "iris": "*"
  }
}